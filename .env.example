PORT=3000
SQLITE_PATH=

# ── Config del negocio por defecto (semilla al arrancar por primera vez) ───────

# Slug unico que aparece en la URL: tuapp.com/mi-negocio
BUSINESS_SLUG=mi-negocio

# Nombre visible del negocio
BUSINESS_NOMBRE=Studio Demo CMR

# Categoria: peluqueria | estetica | masajes | psicologia | legal | otro
BUSINESS_CATEGORIA=peluqueria

BUSINESS_CIUDAD=San Nicolás
BUSINESS_BARRIO=Centro
BUSINESS_COLOR_MARCA=#0f766e

# Horario de apertura y cierre (horas enteras; los turnos deben TERMINAR a más tardar a hora_fin)
BUSINESS_HORA_INICIO=9
BUSINESS_HORA_FIN=20

# Precio de seña por defecto (texto, pesos)
BUSINESS_PRECIO=0

# ── Datos de transferencia ──────────────────────────────────────────────────────
WHATSAPP_NUMERO=5491112345678
TRANSFER_ALIAS=mi.alias.real
TRANSFER_CBU=0000003100099999999999
TRANSFER_TITULAR=Nombre Apellido

# ── Credenciales de admin ───────────────────────────────────────────────────────
# Clave para el super-admin (gestión de negocios): /superadmin
SUPERADMIN_PASSWORD=cambia_esta_clave_maestra
# Clave principal del panel admin del negocio
ADMIN_PASSWORD=admin123
# Clave secundaria opcional (ej: para un segundo administrador)
ADMIN_PASSWORD_SECOND=
# Secreto para firmar los tokens de sesion (cambiarlo en produccion)
ADMIN_SESSION_SECRET=cambia_esta_clave

# ── Suscripción plataforma (datos de cobro mostrados en registro) ───────────────
SUBSCRIPTION_PRECIO=0
SUBSCRIPTION_TRANSFER_ALIAS=
SUBSCRIPTION_TRANSFER_CBU=
SUBSCRIPTION_TRANSFER_TITULAR=

# ── Opcionales: Vercel KV (cache serverless) ───────────────────────────────────
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Opcionales: Supabase (base de datos cloud) ─────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=comprobantes
